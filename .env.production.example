# Production environment for a dedicated Alopera Gym instance (or the shared SaaS).
# Copy to /var/www/alopera-gym/shared/.env and fill in. Never commit real values.
APP_NAME="Alopera Gym"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show (keep it safe: encrypted secrets and backups depend on it)
APP_DEBUG=false
APP_TIMEZONE=Asia/Muscat
APP_URL=https://app.example.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=                       # DigitalOcean Managed PostgreSQL host
DB_PORT=25060
DB_DATABASE=alopera_gym
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

QUEUE_CONNECTION=database      # or redis
CACHE_STORE=database           # or redis
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"


WHATSAPP_DRIVER=meta
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

PAYMOB_BASE_URL=https://oman.paymob.com

GYM_INVENTORY_MODULE=false     # sales & inventory module (off; data kept)

BACKUP_DISK=local
# Off-site copies (scripts/backup-database.sh): DigitalOcean Spaces
SPACES_BUCKET=
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
