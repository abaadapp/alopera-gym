APP_NAME="Alopera Gym"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Muscat
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL — the gym platform has its own database, never shared with ABAAD.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alopera_gym
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Platform (Super Admin) ───────────────────────────────────────────
# Used only by `php artisan platform:create-admin` when no flags are given.
PLATFORM_ADMIN_EMAIL=
PLATFORM_CURRENCY=OMR

# ─── WhatsApp Business Platform (Meta Cloud API) ──────────────────────
# Per-club credentials live encrypted in the database (Settings → Integrations).
# These are platform-wide values used by the webhook endpoint.
WHATSAPP_DRIVER=log            # log | meta
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_APP_SECRET=           # verifies X-Hub-Signature-256 on webhooks
WHATSAPP_VERIFY_TOKEN=         # echoed back on the GET verification handshake

# ─── Paymob (Oman) ────────────────────────────────────────────────────
# Per-club keys live encrypted in the database. This only selects the region.
PAYMOB_BASE_URL=https://oman.paymob.com

# ─── Access-control devices ───────────────────────────────────────────
DEVICES_RATE_LIMIT_PER_MINUTE=120

# ─── Backups ──────────────────────────────────────────────────────────
BACKUP_DISK=local

VITE_APP_NAME="${APP_NAME}"
